### 🎵 공연 스케줄 생성 (좌석 1~50 자동 생성)
POST http://localhost:8080/api/schedules
Content-Type: application/json

{
  "title": "2차 공연",
  "startTime": "2025-10-25T19:00:00",
  "endTime": "2025-10-25T21:00:00",
  "concertId": "{{concertId}}"
}

> {% client.global.set("scheduleId", response.body.id) %}

###

### 🎫 예약 가능한 좌석 조회 (AVAILABLE 상태만)
GET http://localhost:8080/api/seats/available?scheduleId={{scheduleId}}
Content-Type: application/json

> {%
  // 좌석 목록 중 첫 번째 좌석의 seatId를 전역 변수로 저장
  const firstSeat = response.body[0];
  if (firstSeat) {
    client.global.set("seatId", firstSeat.id);
    console.log("✅ 저장된 seatId:", firstSeat.id);
  } else {
    console.log("⚠️ 예약 가능한 좌석이 없습니다.");
  }
%}
